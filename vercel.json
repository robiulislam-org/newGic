{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(.*)\\.sql",
      "destination": "/404"
    },
    {
      "source": "/(.*)\\.py",
      "destination": "/404"
    },
    {
      "source": "/(.*)\\.md",
      "destination": "/404"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/dashboard/",
      "destination": "/dashboard.html"
    },
    {
      "source": "/teachers",
      "destination": "/teachers.html"
    },
    {
      "source": "/teachers/",
      "destination": "/teachers.html"
    },
    {
      "source": "/library",
      "destination": "/library.html"
    },
    {
      "source": "/library/",
      "destination": "/library.html"
    },
    {
      "source": "/services/:slug",
      "destination": "/services/:slug.html"
    },
    {
      "source": "/services/:slug/",
      "destination": "/services/:slug.html"
    },
    {
      "source": "/reviews",
      "destination": "/index.html?page=reviews"
    },
    {
      "source": "/free-courses",
      "destination": "/index.html?page=free-courses"
    },
    {
      "source": "/about",
      "destination": "/index.html?page=about"
    },
    {
      "source": "/contact",
      "destination": "/index.html?page=contact"
    },
    {
      "source": "/privacy-policy",
      "destination": "/index.html?page=privacy-policy"
    },
    {
      "source": "/payment-policy",
      "destination": "/index.html?page=payment-policy"
    },
    {
      "source": "/policy",
      "destination": "/index.html?page=privacy-policy"
    },
    {
      "source": "/policies",
      "destination": "/index.html?page=privacy-policy"
    },
    {
      "source": "/terms",
      "destination": "/index.html?page=privacy-policy"
    }
  ]
}
